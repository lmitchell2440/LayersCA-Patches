<?xml version="1.0" encoding="utf-8" ?>
<Patch>

    <Operation Class="PatchOperationAdd" MayRequire="sarg.alphamechs">
        <xpath>/Defs/ThingDef[defName="AM_MechCommanderHelm"]/apparel</xpath>
        <value>
            <layers>
                <li>Overhead</li>
            </layers>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd" MayRequire="sarg.alphamechs">
        <xpath>/Defs/ThingDef[defName="AM_MechBreakerHelm"]/apparel</xpath>
        <value>
            <layers>
                <li>Overhead</li>
            </layers>
        </value>
    </Operation>

    <Operation Class="PatchOperationAdd" MayRequire="sarg.alphamechs">
        <xpath>/Defs/ThingDef[defName="AM_MechCommanderSuit"]/apparel</xpath>
        <value>
            <layers>
                <li>Cape</li>
            </layers>
        </value>
